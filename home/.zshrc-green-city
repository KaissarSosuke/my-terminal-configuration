# ~/.zshrc — Green City
# Self-contained Zsh config; no framework or plugin install required.
# Matches ~/.config/kitty/themes/green-city.conf

# ── History ──────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY

# ── Shell behavior ───────────────────────────────────────────────────────────
setopt AUTO_CD
setopt AUTO_MENU
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS
setopt PROMPT_SUBST
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END
setopt NO_BEEP

# ── Environment ──────────────────────────────────────────────────────────────
typeset -U path
path=("$HOME/.local/bin" $path)
export PATH

export EDITOR="${EDITOR:-nano}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
export LESS="${LESS:--R}"

# Green-tinted file listing colors (256-color fallbacks)
export LS_COLORS="di=1;38;5;79:ln=1;38;5;123:so=38;5;180:pi=38;5;180:ex=1;38;5;114:bd=38;5;180:cd=38;5;180:su=38;5;203:sg=38;5;203:tw=38;5;180:ow=38;5;180"

# ── Key bindings ─────────────────────────────────────────────────────────────
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# ── Completion ───────────────────────────────────────────────────────────────
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
autoload -Uz compinit
compinit -i

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# ── Prompt ───────────────────────────────────────────────────────────────────
# Minimal one-line prompt: current directory, then a green arrow.
# No username@host, no extra line, no clock on the right.
PROMPT='%F{#8bf0ad}%~%f %F{#4FD18F}>%f '
RPROMPT=''
PROMPT2='%F{#4FD18F}>%f '

# ── Aliases ──────────────────────────────────────────────────────────────────
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias grep='grep --color=auto'

# Use eza automatically once it is installed
if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lah --icons --group-directories-first'
  alias la='eza -A --icons --group-directories-first'
fi

# ── Optional integrations (activate automatically if installed later) ────────
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Starship is intentionally not active.
# To use it instead of the built-in prompt above, uncomment:
# command -v starship >/dev/null && eval "$(starship init zsh)"

if [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

# Keep syntax highlighting last
if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
# Show the custom fetch on every new shell.
command -v fastfetch >/dev/null && fastfetch
